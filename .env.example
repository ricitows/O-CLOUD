# Copia a .env.local y configura valores del proyecto Supabase. No uses claves secretas aquí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Clipdrop, Tripo and OpenAI secrets belong in Supabase Edge Functions Secrets,
# not in this file or the browser: CLIPDROP_API_KEY, TRIPO_API_KEY,
# OPENAI_API_KEY (optional OPENAI_STYLIST_MODEL).
FASHN_API_KEY=
